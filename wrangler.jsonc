{
  // Cloudflare Workers: статичний сайт з кореня репо + worker для службових файлів
  "name": "portfolio",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/sitemap.xml", "/robots.txt", "/llms.txt", "/llms-full.txt"]
  }
}
